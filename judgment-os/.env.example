# Postgres / Supabase (required)
# Dashboard → Project Settings → Database → Connection string (URI)
# Prefer "Transaction" pooler (port 6543) for serverless / small containers.
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres

# LLM provider (replaceable)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://space.ai-builders.com/backend/v1
LLM_MODEL=grok-4-fast
# Prefer LLM_API_KEY; AI_BUILDER_TOKEN also accepted (injected on AI Builders)
LLM_API_KEY=
AI_BUILDER_TOKEN=
