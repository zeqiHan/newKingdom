# Local chassis uses libsql (SQLite file). Postgres schema remains in db/schema.sql.
# Default if unset: file:./data/judgment.db
DATABASE_URL=file:./data/judgment.db

# LLM provider (replaceable — Decision Engine never binds to a vendor)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://space.ai-builders.com/backend/v1
LLM_MODEL=grok-4-fast
# Prefer LLM_API_KEY; AI_BUILDER_TOKEN also accepted
LLM_API_KEY=
AI_BUILDER_TOKEN=
